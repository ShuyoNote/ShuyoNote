{
  "note": "pages.get 分页窗口的跨语言一致性夹具（Rust src-tauri/src/plugins.rs::cap_pages_get 与 TS src/lib/capabilities/frontend.ts 共用同一份）。三个刻意的选择：①用十进制码点数组描述正文（避免两侧对同一份文件的字面字符做不同解码假设，emoji 也不会被编辑器或工具链悄悄改掉）；②期望值只写读数（偏移/总数/返回数/是否还没读完），窗口内容由两侧各自与独立的码点切片参照实现逐字比对——写死正文会让夹具本身成为第三份可能漂移的实现；③limit 上限与默认值也写在夹具里，谁改了上限这里先红。口径：按 Unicode 标量（码点）计数与切片，offset 越界返回空串而非报错，limit 夹到 [1, limitMax]（含 0 与负数 ⇒ 1，不是当成没传）。 另加两条 expectMissing 用例：钉住「id 原样拿去查、不做 trim 也不做归一」——分页锚点必须逐字一致，一端 trim 一端不 trim 就是『同一个字符串在两端不是同一个字符串』（Windows 裁定 2026-09-18 要求把它做成判据，别只停在代码上）。",
  "defaultLimit": 6000,
  "limitMax": 20000,
  "cases": [
    {
      "name": "BMP 中段窗口：offset=6000 必须逐字等于 slice(6000,12000) —— 这条就是验收判据",
      "unit": [
        20250,
        35758,
        32426,
        35201,
        36827,
        23637,
        19982,
        19979,
        21608,
        35745,
        21010
      ],
      "repeat": 1000,
      "offset": 6000,
      "limit": 6000,
      "expectOffset": 6000,
      "expectLimit": 6000,
      "expectTotal": 11000,
      "expectReturned": 5000,
      "expectTruncated": false
    },
    {
      "name": "头部窗口 + 真的还没读完（truncated:true）",
      "unit": [
        20250,
        35758,
        32426,
        35201,
        36827,
        23637,
        19982,
        19979,
        21608,
        35745,
        21010
      ],
      "repeat": 1000,
      "offset": 0,
      "limit": 6000,
      "expectOffset": 0,
      "expectLimit": 6000,
      "expectTotal": 11000,
      "expectReturned": 6000,
      "expectTruncated": true
    },
    {
      "name": "翻到最后一页（窗口不足 limit）⇒ truncated:false，别让调用方无限翻",
      "unit": [
        20057
      ],
      "repeat": 6500,
      "offset": 6000,
      "limit": 6000,
      "expectOffset": 6000,
      "expectLimit": 6000,
      "expectTotal": 6500,
      "expectReturned": 500,
      "expectTruncated": false
    },
    {
      "name": "恰好整除：offset 落在正文末尾 ⇒ 空串 + 真实总数，不是错误",
      "unit": [
        20057
      ],
      "repeat": 6000,
      "offset": 6000,
      "limit": 6000,
      "expectOffset": 6000,
      "expectLimit": 6000,
      "expectTotal": 6000,
      "expectReturned": 0,
      "expectTruncated": false
    },
    {
      "name": "offset 远超过总长 ⇒ 空串，但 chars_total 仍是真实的 100",
      "unit": [
        30002
      ],
      "repeat": 100,
      "offset": 500,
      "limit": 6000,
      "expectOffset": 500,
      "expectLimit": 6000,
      "expectTotal": 100,
      "expectReturned": 0,
      "expectTruncated": false
    },
    {
      "name": "emoji：100 个码点 / 200 个 UTF-16 码元 ⇒ chars_total 必须是 100",
      "unit": [
        128512
      ],
      "repeat": 100,
      "offset": 10,
      "limit": 5,
      "expectOffset": 10,
      "expectLimit": 5,
      "expectTotal": 100,
      "expectReturned": 5,
      "expectTruncated": true
    },
    {
      "name": "emoji 混排且 offset 落在代理对中间：按 UTF-16 切会切出半个字符，按码点切不会",
      "unit": [
        97,
        128512,
        20013
      ],
      "repeat": 7,
      "offset": 5,
      "limit": 7,
      "expectOffset": 5,
      "expectLimit": 7,
      "expectTotal": 21,
      "expectReturned": 7,
      "expectTruncated": true
    },
    {
      "name": "limit 超过上限 ⇒ 夹到 20000",
      "unit": [
        30002,
        20057
      ],
      "repeat": 15000,
      "offset": 0,
      "limit": 999999,
      "expectOffset": 0,
      "expectLimit": 20000,
      "expectTotal": 30000,
      "expectReturned": 20000,
      "expectTruncated": true
    },
    {
      "name": "★ limit=0 ⇒ 夹到 1（不是当成没传）—— TS 侧写 `args.limit || 默认` 会变 6000，与 Rust 的 clamp(1,·) 分道扬镳",
      "unit": [
        30002
      ],
      "repeat": 100,
      "offset": 0,
      "limit": 0,
      "expectOffset": 0,
      "expectLimit": 1,
      "expectTotal": 100,
      "expectReturned": 1,
      "expectTruncated": true
    },
    {
      "name": "★ limit 为负 ⇒ 同样夹到 1",
      "unit": [
        30002
      ],
      "repeat": 100,
      "offset": 0,
      "limit": -3,
      "expectOffset": 0,
      "expectLimit": 1,
      "expectTotal": 100,
      "expectReturned": 1,
      "expectTruncated": true
    },
    {
      "name": "★ offset 为负 ⇒ 当 0（负数偏移在两条路径上都必须是「从头开始」）",
      "unit": [
        30002
      ],
      "repeat": 100,
      "offset": -5,
      "limit": 10,
      "expectOffset": 0,
      "expectLimit": 10,
      "expectTotal": 100,
      "expectReturned": 10,
      "expectTruncated": true
    },
    {
      "name": "★ id 带首尾空格 ⇒ 两侧都**原样拿 id 去查**（不 trim、不归一）⇒ 查不到（expectMissing）",
      "expectMissing": true,
      "idProbe": " pk0 "
    },
    {
      "name": "★ id 大小写不同 ⇒ 同样**不归一** ⇒ 查不到（expectMissing）",
      "expectMissing": true,
      "idProbe": "PK0"
    }
  ]
}
