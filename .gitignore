# Generated web deploy version marker (scripts/write-version-json.mjs)
public/version.json

# Local scratch / CDP test temp + Edge profiles (never committed)
tmp
demo-shots

# 商业 / 运营材料绝不进本公开仓库（AGPL 客户端），它们属于私有的
# shuyonote-sync-server 仓库。显式挡一层，防止 `git add -A` 再次误收
# （2026-09-01 已发生过一次：6 份付费客户/值班/工单文档被误推到公开仓库）。
docs/operations-*.md
docs/customer-facing-playbook.*
docs/duty-roster*
docs/zammad-*.md
scripts/export-customer-playbook.mjs

# 内容运营 / 对外传播材料（知乎答题、公众号、推广文案等）同样属于运营材料，
# 不进公开仓库：正文放 tmp/（第 29 行已忽略）或私有仓库。
# 2026-09-14 新增，起因：知乎答题定稿曾放在仓库根目录待归档。
docs/zhihu-*
zhihu/
zhihu-*.md
docs/marketing-*
docs/promo-*

# 社区帖子的带时间戳生成型备份（表结构 / 正文快照），属生成产物，不入公开仓库。
# 正式帖子正文仍由 docs/community/*.md 跟踪（如 plugin-recipes-post.md）。
# 2026-09-14 新增：该目录为未跟踪状态且未命中任何规则，git add -A 会误收。
docs/community/backup/

# Rust build artifacts
src-tauri/target

# Tauri 生成的移动端工程与校验 schema（`tauri android init` / build 生成，可重建）
src-tauri/gen

# 本地产出的发布物 / 安装包（本地构建产物，不入库）
release/

# PDFium 动态库（由 scripts/fetch-pdfium.mjs 按钉死版本 + 校验和拉取；二进制不入库）
src-tauri/vendor/pdfium/

# Android 用的**静态** Tongsuo（由 scripts/build-tongsuo-android.sh 交叉编译产出；
# `scripts/check-openssl-android.mjs` 按钉死的 sha256 核对。二进制不入库 —— 它是构建产物，
# 且要能被独立复核；换机器必须能编出**同样的字节**，所以 Configure 用固定前缀 ＋ DESTDIR）
src-tauri/vendor/openssl/

# 随包字体（由 scripts/fetch-font.mjs 按钉死版本 + 校验和拉取；字体本体不入库）
# ⚠️ 同目录的 README.md **要入库** —— 它是 tauri.linux.conf.json 里 `assets/fonts/*` 那条映射的占位，
#    少了它那个 glob 会匹配 0 个文件、构建期直接红（实测：`cargo check` 报 glob pattern … didn't match）。
src-tauri/assets/fonts/*.ttf
src-tauri/assets/fonts/*.otf
src-tauri/assets/fonts/LICENSE-OFL.txt

