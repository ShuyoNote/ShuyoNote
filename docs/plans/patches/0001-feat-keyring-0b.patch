diff --git a/scripts/verify-space-keyring.mjs b/scripts/verify-space-keyring.mjs
new file mode 100644
index 0000000..d4dcde5
--- /dev/null
+++ b/scripts/verify-space-keyring.mjs
@@ -0,0 +1,138 @@
+// Space keyring (public material) endpoints — v16 / 0b.
+//
+// What this asserts: the public half of a client "keyring" (KDF salt/params + passphrase-wrapped
+// space keys) can be stored on and fetched from the server, and the server neither parses it nor
+// leaks it into the audit log. The server CANNOT open a space with it (no passphrase ⇒ no master
+// key ⇒ AEAD refuses); authenticity is the client's AEAD check, not a server-side signature.
+//
+// Usage (K1 deployment — the personal/no-account key, which acts as the bearer token):
+//
+//   ./target/release/shuyonote-sync-server --issue-device-key --space sp-e2e --db <tmp>/sync.db
+//   ./target/release/shuyonote-sync-server --port 8788 --db <tmp>/sync.db --backup-interval-hours 0
+//   node scripts/verify-space-keyring.mjs http://127.0.0.1:8788 sk_<the key printed above>
+//
+// Exit code is the number of failures (0 = all good). NOTE: we set `process.exitCode` instead of
+// calling `process.exit()` — on Windows, exiting with fetch keep-alive handles still open trips
+// libuv (`Assertion failed: !(handle->flags & UV_HANDLE_CLOSING)`, exit -1073740791), which makes
+// "the probe failed" and "node crashed" indistinguishable.
+const SERVER = (process.argv[2] || "http://127.0.0.1:8787").replace(/\/+$/, "");
+const TOKEN = process.argv[3] || "";
+const SP = "sp-e2e";
+const OTHER = "sp-other";
+
+let failures = 0;
+
+function ok(cond, label, extra = "") {
+  if (cond) {
+    console.log(`  PASS  ${label}`);
+  } else {
+    failures++;
+    console.log(`  FAIL  ${label}${extra ? ` — ${extra}` : ""}`);
+  }
+}
+
+async function req(method, path, { token = TOKEN, body } = {}) {
+  const headers = {};
+  if (token) headers.Authorization = `Bearer ${token}`;
+  let payload;
+  if (body !== undefined) {
+    headers["Content-Type"] = "application/json";
+    payload = JSON.stringify(body);
+  }
+  const res = await fetch(`${SERVER}${path}`, { method, headers, body: payload });
+  const text = await res.text();
+  let json = null;
+  try {
+    json = JSON.parse(text);
+  } catch {
+    /* not JSON — leave null, callers assert on the status code */
+  }
+  return { status: res.status, text, json };
+}
+
+// Shaped like the client's `Keyring::to_json()`: a salt, KDF params, one wrapped box, plus a
+// non-ASCII key and an unknown field — the server must hand all of it back byte for byte.
+const MATERIAL = JSON.stringify(
+  {
+    v: 1,
+    kdf: { alg: "argon2id", m: 19456, t: 2, p: 1, salt: "9f8eadbeef" },
+    spaces: { default: { box: "AAECAwQFBgcICQ==", wrapped_at: 1758600000000 } },
+    "未来字段": "this server does not know this field — it must still come back unchanged",
+  },
+  null,
+  2,
+);
+const MATERIAL2 = MATERIAL.replace("9f8eadbeef", "0011223344");
+
+if (!TOKEN) {
+  console.log("usage: node scripts/verify-space-keyring.mjs <server> <device-key>");
+  process.exitCode = 1;
+} else {
+  const url = (sp) => `/spaces/${sp}/keyring`;
+
+  // 1. unauthenticated read is refused by the auth layer
+  {
+    const r = await req("GET", url(SP), { token: "" });
+    ok(r.status === 401, "unauthenticated GET is 401", `status=${r.status}`);
+  }
+  // 2. the owner may store it, and the server reports how many bytes it took
+  {
+    const r = await req("PUT", url(SP), { body: { keyring_json: MATERIAL } });
+    const want = Buffer.byteLength(MATERIAL, "utf8");
+    ok(
+      r.status === 200 && r.json?.bytes === want,
+      "owner PUT is 200 and echoes the byte count",
+      `status=${r.status} bytes=${r.json?.bytes} want=${want}`,
+    );
+  }
+  // 3. and gets the exact same string back (no parsing, no re-ordering)
+  {
+    const r = await req("GET", url(SP));
+    ok(
+      r.status === 200 && r.json?.keyring_json === MATERIAL,
+      "GET returns keyring_json byte for byte",
+      `status=${r.status} identical=${r.json?.keyring_json === MATERIAL}`,
+    );
+  }
+  // 4. a device key is scoped to exactly one space
+  {
+    const r = await req("GET", url(OTHER));
+    ok(r.status === 403, "a key scoped to another space gets 403", `status=${r.status}`);
+  }
+  // 5. overwriting is rotation: only the new copy survives
+  {
+    const p = await req("PUT", url(SP), { body: { keyring_json: MATERIAL2 } });
+    const g = await req("GET", url(SP));
+    ok(
+      p.status === 200 && g.status === 200 && g.json?.keyring_json === MATERIAL2,
+      "a second PUT replaces the stored material (rotation)",
+      `put=${p.status} get=${g.status} is_new=${g.json?.keyring_json === MATERIAL2}`,
+    );
+  }
+  // 6. delete, and deleting nothing must not pretend to have succeeded
+  {
+    const d = await req("DELETE", url(SP));
+    const g = await req("GET", url(SP));
+    ok(d.status === 200 && g.status === 404, "DELETE is 200 and GET is then 404", `delete=${d.status} get=${g.status}`);
+    const d2 = await req("DELETE", url(SP));
+    ok(d2.status === 404, "a second DELETE is 404 (idempotent, not a fake success)", `status=${d2.status}`);
+  }
+  // 7. the audit trail records the write by size only — never the material itself
+  {
+    const r = await req("GET", `/spaces/${SP}/audit`);
+    // NOTE: the body is `{ items: [...] }` — asserted here because the first draft of this probe
+    // looked for `entries`, saw 0 rows, and wrongly reported "the audit did not record it".
+    const rows = Array.isArray(r.json) ? r.json : (r.json?.items ?? []);
+    const text = JSON.stringify(rows);
+    const recorded = text.includes("space_keyring.put");
+    const leaked = text.includes("9f8eadbeef") || text.includes("未来字段") || text.includes("AAECAwQFBgcICQ");
+    ok(
+      r.status === 200 && recorded && !leaked,
+      "audit records the PUT by byte count and never copies the material",
+      `status=${r.status} recorded=${recorded} leaked=${leaked} rows=${rows.length}`,
+    );
+  }
+
+  console.log(`\n${failures === 0 ? "OK" : "FAILED"} — space keyring: ${failures} failure(s)`);
+  process.exitCode = failures === 0 ? 0 : 1;
+}
