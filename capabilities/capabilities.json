{
  "registryVersion": 1,
  "apiVersion": "1.0.0",
  "notes": "插件能力注册表——单一事实源。scripts/gen-capabilities.mjs 由本文件生成：JS shim（api.*）、Rust 绑定表、作者类型包、作者文档；scripts/check-capabilities.mjs 校验一致性与完整性。改能力请改这里，不要手改生成物。",
  "permissions": [
    {
      "id": "read:page.current",
      "title": "读取当前页正文",
      "risk": "low",
      "desc": "读取当前打开页面的 content_json"
    },
    {
      "id": "read:pages",
      "title": "读取本空间页面统计",
      "risk": "low",
      "desc": "读取本空间的页面数量等汇总信息（不含正文）"
    },
    {
      "id": "write:page.current",
      "title": "向当前页写入纯文本",
      "risk": "low",
      "desc": "往当前页面插入一段纯文本（不接受 HTML/Markdown，不可删改既有内容）"
    },
    {
      "id": "read:tags",
      "title": "读取本空间标签",
      "risk": "low",
      "desc": "读取本空间的标签清单（名称与关联页面数）"
    },
    {
      "id": "read:backlinks",
      "title": "读取反链",
      "risk": "low",
      "desc": "读取哪些页面引用了某个页面"
    },
    {
      "id": "read:files",
      "title": "读取附件元数据",
      "risk": "low",
      "desc": "读取页面的附件元数据（名称/类型/大小），**不含文件字节**"
    },
    {
      "id": "kv:own",
      "title": "存储自己的数据",
      "risk": "low",
      "desc": "在插件自己的命名空间里读写键值（与其他插件、与笔记数据互不可见）"
    },
    {
      "id": "write:pages",
      "title": "新建页面 / 追加内容",
      "risk": "medium",
      "desc": "新建页面或向页面追加内容；**写入前会先给你看草稿并等你确认**（不直接落库）"
    },
    {
      "id": "read:properties",
      "title": "读取属性定义",
      "risk": "low",
      "desc": "读取本空间的属性定义（名称/类型/id），供插件找到要写的属性"
    },
    {
      "id": "write:properties",
      "title": "设置页面属性",
      "risk": "medium",
      "desc": "给页面设置属性值；**写入前会先给你看草稿并等你确认**"
    },
    {
      "id": "write:tags",
      "title": "给页面加标签",
      "risk": "medium",
      "desc": "给页面加标签；**写入前会先给你看草稿并等你确认**"
    }
  ],
  "events": [
    {
      "id": "app.started",
      "title": "应用启动",
      "desc": "应用启动完成、插件已加载后触发一次",
      "since": "1.0.0",
      "hosted": true
    },
    {
      "id": "space.switched",
      "title": "切换空间",
      "desc": "切换到另一个空间后触发（payload: spaceId）",
      "since": "1.0.0",
      "hosted": true
    },
    {
      "id": "page.opened",
      "title": "打开页面",
      "desc": "打开一个页面后触发（payload: pageId）",
      "since": "1.0.0",
      "hosted": true
    },
    {
      "id": "page.saved",
      "title": "页面已保存",
      "desc": "页面内容或标题保存后触发（payload: pageId, title）",
      "since": "1.0.0",
      "hosted": true
    },
    {
      "id": "page.deleted",
      "title": "页面已删除",
      "desc": "页面被删除后触发（payload: pageId）",
      "since": "1.0.0",
      "hosted": true
    },
    {
      "id": "import.finished",
      "title": "导入完成",
      "desc": "一次导入结束后触发（payload: count）",
      "since": "1.0.0",
      "hosted": false
    },
    {
      "id": "sync.completed",
      "title": "同步完成",
      "desc": "一次同步结束后触发（payload: pushed, pulled）",
      "since": "1.0.0",
      "hosted": false
    }
  ],
  "menus": [
    {
      "id": "slash",
      "title": "编辑器「/」菜单",
